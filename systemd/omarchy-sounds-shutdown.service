[Unit]
Description=Omarchy Sounds shutdown chime
# Stopped before the audio stack on poweroff/reboot/logout, so the sound can still play.
After=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=%h/.local/bin/omarchy-sounds-play --wait shutdown
TimeoutStopSec=8

[Install]
WantedBy=default.target
