#!/usr/bin/env bash
# omarchy-sounds-daemon — plays sounds for events Hyprland can't see.
# Runs as omarchy-sounds.service; each watcher is a small pipeline that turns
# a system event stream into omarchy-sounds-play calls.
#
#   lock / unlock                  omarchy-shell's lock log in the user journal
#   notification(-critical)        Notify calls on the session bus
#   screenshot                     Omarchy's "Screenshot saved" notification
#   device-connect / -disconnect   udev (USB) and BlueZ (Bluetooth)
#   charger-connect / -disconnect  UPower OnBattery
#   battery-critical               UPower battery percentage
#
# If any watcher exits, the daemon exits too and systemd restarts the lot.

conf="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-sounds"
state="${XDG_RUNTIME_DIR:-/tmp}/omarchy-sounds"
mkdir -p "$state"

play() { omarchy-sounds-play "$1"; }

# Devices reconnect in bursts after resume or when a hub is plugged in, so after
# waking we stay quiet for a few seconds and never play the same device sound
# twice within a second.
quiet() {
  local until=0
  [ -f "$state/quiet-until" ] && read -r until < "$state/quiet-until"
  (( $(date +%s) < until ))
}

on_ac() {
  local supply type online
  for supply in /sys/class/power_supply/*; do
    read -r type < "$supply/type" 2>/dev/null
    [ "$type" = Mains ] || continue
    read -r online < "$supply/online" 2>/dev/null
    [ "$online" = 1 ] && return 0
  done
  return 1
}

declare -A last_played
device_sound() {
  quiet && return
  local now; now=$(date +%s%N)
  (( now - ${last_played[$1]:-0} < 1000000000 )) && return
  last_played[$1]=$now
  play "$1"
}

watch_lock() {
  journalctl --user -f -n0 -o cat SYSLOG_IDENTIFIER=omarchy-shell |
    while IFS= read -r line; do
      case $line in
        *"omarchy lock "*" secure=true"*) play lock ;;
        *"omarchy lock "*" unlocked"*)    play unlock ;;
      esac
    done
}

# dbus-monitor prints each Notify call over several lines; awk folds them into
# "replaces_id<TAB>urgency<TAB>summary". Argument order: app, replaces_id, icon,
# summary, body, actions, hints, timeout (the only top-level int32).
watch_notifications() {
  dbus-monitor --session "type='method_call',interface='org.freedesktop.Notifications',member='Notify'" 2>/dev/null |
    awk '
      /member=Notify$/ { inmsg = 1; strings = 0; replaces = 0; urgency = 1; summary = ""; next }
      !inmsg { next }
      /^   uint32 / { replaces = $2 }
      /^   string / {
        strings++
        if (strings == 3) { summary = $0; sub(/^   string "/, "", summary); sub(/"$/, "", summary) }
      }
      /string "urgency"/ { want_urgency = 1; next }
      want_urgency && /variant/ { urgency = $NF; want_urgency = 0 }
      /^   int32 / { printf "%s\t%s\t%s\n", replaces, urgency, summary; fflush(); inmsg = 0 }
    ' |
    while IFS=$'\t' read -r replaces urgency summary; do
      # Updates to an existing notification (progress bars etc.) stay quiet.
      [ "$replaces" != 0 ] && continue
      case $summary in
        "Screenshot saved"*) play screenshot; continue ;;
        "Time to recharge!") continue ;;  # the battery-low hook plays that one
      esac
      if [ "$urgency" = 2 ]; then
        play notification-critical
      elif [ "$(omarchy-shell notifications isDnd 2>/dev/null)" != on ]; then
        play notification
      fi
    done
}

watch_usb() {
  udevadm monitor --udev --subsystem-match=usb/usb_device |
    while read -r _ _ action _; do
      case $action in
        add)    device_sound device-connect ;;
        remove) device_sound device-disconnect ;;
      esac
    done
}

watch_bluetooth() {
  gdbus monitor --system --dest org.bluez |
    while IFS= read -r line; do
      [[ $line == *"'org.bluez.Device1'"* ]] || continue
      case $line in
        *"'Connected': <true>"*)  device_sound device-connect ;;
        *"'Connected': <false>"*) device_sound device-disconnect ;;
      esac
    done
}

watch_power() {
  local critical_sent=0 level threshold
  gdbus monitor --system --dest org.freedesktop.UPower |
    while IFS= read -r line; do
      case $line in
        *"'OnBattery': <false>"*) play charger-connect; critical_sent=0 ;;
        *"'OnBattery': <true>"*)  play charger-disconnect ;;
      esac
      if [[ $line == /org/freedesktop/UPower/devices/DisplayDevice:* && $line =~ \'Percentage\':\ \<([0-9.]+)\> ]]; then
        level=${BASH_REMATCH[1]%.*}
        CRITICAL_BATTERY_LEVEL=5; [ -f "$conf/config" ] && . "$conf/config"
        threshold=$CRITICAL_BATTERY_LEVEL
        if (( level <= threshold )) && [ "$critical_sent" = 0 ] && ! on_ac; then
          play battery-critical; critical_sent=1
        elif (( level > threshold + 2 )); then
          critical_sent=0
        fi
      fi
    done
}

# Resume from suspend: quiet period for the device reconnect burst.
watch_sleep() {
  gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 |
    while IFS= read -r line; do
      [[ $line == *"PrepareForSleep (false"* ]] && echo $(( $(date +%s) + 8 )) > "$state/quiet-until"
    done
}

# Sourcing the file (for tests) defines the watchers without starting them.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

trap 'kill 0 2>/dev/null' EXIT
watch_lock & watch_notifications & watch_usb & watch_bluetooth & watch_power & watch_sleep &
wait -n
exit 1
