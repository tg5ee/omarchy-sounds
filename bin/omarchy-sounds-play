#!/usr/bin/env bash
# omarchy-sounds-play [--wait] [--force] EVENT
# Plays ~/.config/omarchy-sounds/sounds/EVENT.{wav,ogg,oga,flac,mp3} if the event
# is enabled (--force skips the on/off checks, for previews). Silent (exit 0) when the file is missing, so you can add sounds later.
# Kept lean on purpose: this runs on every mouse click.

wait=0 force=0
while :; do
  case "$1" in
    --wait)  wait=1; shift ;;
    --force) force=1; shift ;;
    *) break ;;
  esac
done
event=$1
[ -n "$event" ] || exit 0

conf="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-sounds"
ENABLED=1 VOLUME=0.6
[ -f "$conf/config" ] && . "$conf/config"
# `omarchy-sounds log on` records every trigger, played or not, for troubleshooting
if [ "${LOG:-0}" = 1 ]; then
  log_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-sounds"
  mkdir -p "$log_dir" && printf '%(%T)T %s\n' -1 "$event" >> "$log_dir/events.log"
fi

if [ "$force" = 0 ]; then
  [ "$ENABLED" = 1 ] || exit 0
  # startup -> STARTUP, window-open -> WINDOW_OPEN
  var=${event^^}; var=${var//-/_}
  [ "${!var:-1}" = 1 ] || exit 0
fi

file=
for ext in wav ogg oga flac mp3; do
  [ -f "$conf/sounds/$event.$ext" ] && { file="$conf/sounds/$event.$ext"; break; }
done
[ -n "$file" ] || exit 0

if command -v pw-play >/dev/null; then
  cmd=(pw-play --volume "$VOLUME" "$file")
elif command -v paplay >/dev/null; then
  cmd=(paplay --volume "$(awk -v v="$VOLUME" 'BEGIN{printf "%d", v*65536}')" "$file")
else
  cmd=(mpv --no-video --really-quiet --volume="$(awk -v v="$VOLUME" 'BEGIN{printf "%d", v*100}')" "$file")
fi

if [ "$wait" = 1 ]; then
  "${cmd[@]}" >/dev/null 2>&1
else
  "${cmd[@]}" >/dev/null 2>&1 &
  disown
fi
